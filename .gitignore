# ==============================================================================
# Open Interest — Git Ignore Rules
# ==============================================================================

# Environment files & secrets (DO NOT COMMIT)
.env
.env.local
.env.*.local
*.env
!.env.example

# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Production Build Outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database data & dumps
*.dump
*.sql.bak
.postgres-data/

# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
