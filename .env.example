# ==============================================================================
# Open Interest — Environment Variables Template
# Copy this file to .env and configure your values:
#   cp .env.example .env
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=open_interest
DB_HOST=localhost
DB_PORT=5432

# pgBouncer Configuration
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_SIZE=20

# Kafka Configuration (KRaft Mode)
KAFKA_BROKER=kafka:9092
KAFKA_BROKER_EXTERNAL=localhost:29092

# JWT Security (Use a cryptographically secure random string in production)
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_in_production

# Default Seed Account Passwords (Change in Production)
ADMIN_PASSWORD=change_admin_password_here
TRADER1_PASSWORD=change_trader1_password_here
TRADER2_PASSWORD=change_trader2_password_here

# Microservice Ports
PORT_EXCHANGE=4001
PORT_ROM=4003
PORT_SOR=4004
PORT_PIQ=4005
PORT_APPSERVER=4006

# Market Data Server Mode (RANDOM_WALK or USER_DRIVEN)
MDS_MODE=USER_DRIVEN
