# ==============================================================================
# Open Interest — Environment Variables Template
# Copy this file to .env and configure your values:
#   cp .env.example .env
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=open_interest
DB_HOST=timescaledb
DB_PORT=5432

# pgBouncer Configuration
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_SIZE=20

# Kafka Configuration (KRaft Mode)
KAFKA_BROKER=kafka:9092
KAFKA_BROKER_EXTERNAL=localhost:29092

# JWT Security
JWT_SECRET=super_secret_open_interest_jwt_key_2026

# Default Seed Account Passwords (Double-quoted due to special chars like #)
ADMIN_PASSWORD="T@jFUHkUVzkHoNhbj#98!"
TRADER1_PASSWORD="Tr1#oHMACIn3Am79!"
TRADER2_PASSWORD="Tr2#sEcuR3Pass99!"

# Microservice Ports
PORT_EXCHANGE=4001
PORT_ROM=4003
PORT_SOR=4004
PORT_PIQ=4005
PORT_APPSERVER=4006
EXCHANGE_URL=http://localhost:4001

# Market Data Server Mode (RANDOM_WALK or USER_DRIVEN)
MDS_MODE=RANDOM_WALK
